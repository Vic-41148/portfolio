# Copy to .dev.vars for local development (git-ignored).
# In production these are Cloudflare Worker secrets, not files.

# Password for the hidden writing editor at /writing/new
ADMIN_PASSWORD=

# Fine-grained GitHub PAT, scoped to this repo only, with Contents: Read & write.
# The editor commits posts with it.
GITHUB_TOKEN=

GITHUB_REPO=Vic-41148/portfolio
GITHUB_BRANCH=main
