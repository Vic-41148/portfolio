{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "portfolio",
	"compatibility_date": "2026-07-10",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "portfolio"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"observability": {
		"enabled": true
	},
	// Not secrets — the repo is public. ADMIN_PASSWORD and GITHUB_TOKEN are set
	// with `wrangler secret put` and never live in this file.
	"vars": {
		"GITHUB_REPO": "Vic-41148/portfolio",
		"GITHUB_BRANCH": "main"
	},
	// Newsletter subscribers. Create with:
	//   npx wrangler d1 create portfolio-subscribers
	// then paste the returned database_id below and apply the migration:
	//   npx wrangler d1 migrations apply portfolio-subscribers --remote
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "portfolio-subscribers",
			"database_id": "a3a5390d-2551-4fac-8e45-e2f06ae39dd8",
			"migrations_dir": "migrations"
		}
	]
}
