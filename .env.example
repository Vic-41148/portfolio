# Copy this file to .env.local and fill in the blanks.
#   cp .env.example .env.local
#
# .env.local is git-ignored — real values go there, never in this file.
# In production these live as Cloudflare Worker secrets instead:
#   npx wrangler secret put NAME
# (GITHUB_REPO and GITHUB_BRANCH are already set as vars in wrangler.jsonc,
# so production only needs the two secrets marked "secret" below.)

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://adityashibu.com

# --- Contact form -----------------------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=adityashibu275898@gmail.com
CONTACT_EMAIL=adityashibu41148@gmail.com
CONTACT_FROM=Portfolio Contact <contact@adityashibu.com>

# secret · resend.com/api-keys → Create API key
# Without it the contact form returns an error.
RESEND_API_KEY=

# --- Writing editor (/writing/new) ------------------------------------------
# Reachable by entering the Konami code on /writing: ↑ ↑ ↓ ↓ ← → ← → B A
# Leave ADMIN_PASSWORD blank and the editor stays disabled (returns 503).

# secret · pick your own; this is the only thing gating the editor, so make it
# long. Changing it invalidates every signed-in session immediately.
ADMIN_PASSWORD=

# secret · github.com/settings/personal-access-tokens/new  (Fine-grained token)
#   Resource owner ......... Vic-41148
#   Repository access ...... Only select repositories → Vic-41148/portfolio
#   Permissions ............ Repository → Contents: Read and write
#                            (Metadata: Read-only is added automatically)
#   Expiration ............. shown once on creation — note the renewal date,
#                            publishing fails with a 502 once it lapses.
# The token is shown a single time. Paste it here, not into .env.example.
GITHUB_TOKEN=

# owner/repo the editor commits posts to. No email or username needed —
# GitHub attributes commits to whoever owns the token.
GITHUB_REPO=Vic-41148/portfolio

# Branch posts are committed to. Use "dev" while testing so drafts never
# touch production; production uses "main" (set in wrangler.jsonc).
GITHUB_BRANCH=dev
